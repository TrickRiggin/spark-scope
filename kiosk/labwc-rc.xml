<?xml version="1.0"?>
<!--
  labwc snippet for a kiosk without a mouse: hides the pointer over the Spark Scope panel.
  Install as ~/.config/labwc/rc.xml, or merge the <windowRules> block into the one you already have.
  Raspberry Pi OS starts labwc with -m, so this file merges with /etc/xdg/labwc/rc.xml instead of
  replacing it. Reload with: kill -HUP $(pgrep -x labwc)

  Why: on Wayland the page's own `cursor: none` only applies once the pointer enters the window, so
  the compositor's cursor stays visible over the panel. When the Chromium window maps, this moves the
  pointer into it and hides it until a real pointer moves.
-->
<labwc_config>
  <windowRules>
    <windowRule identifier="chromium*">
      <action name="WarpCursor" to="output" x="center" y="center" />
      <action name="HideCursor" />
    </windowRule>
  </windowRules>
</labwc_config>
